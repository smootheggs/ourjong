{
    "name": "@ourjong/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Multiplayer WebSocket backend for Ourjong (Express + Socket.io on top of @ourjong/engine)",
    "scripts": {
      "build": "tsc",
      "dev": "tsx watch src/index.ts",
      "start": "tsx src/index.ts",
      "typecheck": "tsc --noEmit",
      "test": "vitest run"
    },
    "dependencies": {
      "@ourjong/engine": "*",
      "express": "^4.21.2",
      "socket.io": "^4.8.1"
    },
    "devDependencies": {
      "@types/express": "^4.17.21",
      "@types/node": "^22.10.0",
      "tsx": "^4.19.2",
      "typescript": "^5.6.3",
      "vitest": "^2.1.8"
    }
  }