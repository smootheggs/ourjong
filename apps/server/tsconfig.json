{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "allowImportingTsExtensions": true,
      "noEmit": true,
      "strict": false,
      "noUncheckedIndexedAccess": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "types": ["node"]
    },
    "include": ["src"]
  }